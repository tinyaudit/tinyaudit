<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>TinyAudit Card &mdash; {{ card.dataset }} / {{ card.model }}</title>
<style>
  @page {
    size: A4;
    margin: 14mm;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #1a1a1a;
    font-size: 11px;
    line-height: 1.4;
  }
  .page {
    width: 100%;
  }
  header {
    border-bottom: 3px solid #1a1a1a;
    padding-bottom: 8px;
    margin-bottom: 12px;
  }
  header h1 {
    margin: 0;
    font-size: 20px;
    letter-spacing: 0.5px;
  }
  header .subtitle {
    margin-top: 4px;
    font-size: 12px;
    color: #555;
  }
  .meta-grid {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
  }
  .meta-cell {
    flex: 1;
    background: #f4f4f5;
    border: 1px solid #e0e0e2;
    border-radius: 4px;
    padding: 8px 10px;
  }
  .meta-cell .label {
    text-transform: uppercase;
    font-size: 8.5px;
    letter-spacing: 0.8px;
    color: #777;
  }
  .meta-cell .value {
    font-size: 14px;
    font-weight: 600;
    margin-top: 2px;
    word-break: break-word;
  }
  section {
    margin-bottom: 14px;
    page-break-inside: avoid;
  }
  h2 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 4px;
    margin: 0 0 8px 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th, td {
    text-align: left;
    padding: 5px 8px;
    border-bottom: 1px solid #eaeaea;
  }
  th {
    font-size: 8.5px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #777;
  }
  td.num {
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
  }
  .footprint-grid {
    display: flex;
    gap: 10px;
  }
  .fp-cell {
    flex: 1;
    text-align: center;
    background: #f4f4f5;
    border: 1px solid #e0e0e2;
    border-radius: 4px;
    padding: 10px 6px;
  }
  .fp-cell .fp-value {
    font-size: 16px;
    font-weight: 700;
  }
  .fp-cell .fp-label {
    font-size: 8.5px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #777;
    margin-top: 3px;
  }
  .perf-green { border-top: 3px solid #1f9d55; }
  .perf-amber { border-top: 3px solid #d9920a; }
  .perf-red { border-top: 3px solid #d23b3b; }
  .perf-note {
    font-size: 8.5px;
    color: #777;
    margin-top: 5px;
    line-height: 1.35;
  }
  .band {
    display: inline-block;
    min-width: 56px;
    text-align: center;
    padding: 3px 8px;
    border-radius: 10px;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #fff;
  }
  .band-green { background: #1f9d55; }
  .band-amber { background: #d9920a; }
  .band-red { background: #d23b3b; }
  .dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 6px;
    vertical-align: middle;
  }
  .dot.band-green { background: #1f9d55; }
  .dot.band-amber { background: #d9920a; }
  .dot.band-red { background: #d23b3b; }
  .tag {
    display: inline-block;
    background: #1a1a1a;
    color: #fff;
    border-radius: 3px;
    padding: 2px 7px;
    font-size: 9px;
    margin: 0 4px 4px 0;
  }
  .muted { color: #888; font-style: italic; }
  footer {
    margin-top: 16px;
    border-top: 1px solid #ccc;
    padding-top: 6px;
    font-size: 8.5px;
    color: #999;
    word-break: break-all;
  }
</style>
</head>
<body>
<div class="page">

  <header>
    <h1>TinyAudit Card</h1>
    <div class="subtitle">
      Fairness, uncertainty &amp; explainability within a microcontroller-class footprint
    </div>
  </header>

  <div class="meta-grid">
    <div class="meta-cell">
      <div class="label">Dataset</div>
      <div class="value">{{ card.dataset }}</div>
    </div>
    <div class="meta-cell">
      <div class="label">Model</div>
      <div class="value">{{ card.model }}</div>
    </div>
    <div class="meta-cell">
      <div class="label">Compression</div>
      <div class="value">{{ card.compression if card.compression else "none" }}</div>
    </div>
  </div>

  <section>
    <h2>Footprint</h2>
    <div class="footprint-grid">
      <div class="fp-cell">
        <div class="fp-value">{{ "{:,}".format(card.footprint.n_params) }}</div>
        <div class="fp-label">Parameters</div>
      </div>
      <div class="fp-cell">
        <div class="fp-value">{{ "{:,}".format(card.footprint.peak_ram_bytes) }}</div>
        <div class="fp-label">Peak RAM (bytes)</div>
      </div>
      <div class="fp-cell">
        <div class="fp-value">{{ "{:,}".format(card.footprint.flops) }}</div>
        <div class="fp-label">FLOPs</div>
      </div>
      <div class="fp-cell">
        <div class="fp-value">{{ "%.3e"|format(card.footprint.wall_clock_s_per_sample) }}</div>
        <div class="fp-label">Latency (s / sample)</div>
      </div>
    </div>
  </section>

  {% if card.performance %}
  <section>
    <h2>Predictive performance</h2>
    <div class="footprint-grid">
      {% for m in card.performance.metrics %}
      <div class="fp-cell perf-{{ m.band }}">
        <div class="fp-value">{{ "%.3f"|format(m.value) }}</div>
        <div class="fp-label">{{ m.name.replace("_", " ") }}</div>
      </div>
      {% endfor %}
    </div>
    <div class="perf-note">
      Majority-class rate on this evaluation set is
      {{ "%.3f"|format(card.performance.majority_class_rate) }}. Read the fairness
      block below against these: a model that answers one class for every input
      scores perfect parity.
    </div>
  </section>
  {% endif %}

  <section>
    <h2>Fairness (point prediction)</h2>
    <table>
      <thead>
        <tr><th>Metric</th><th>Value</th><th>Status</th></tr>
      </thead>
      <tbody>
        {% for m in card.fairness.metrics %}
        <tr>
          <td><span class="dot band-{{ m.band }}"></span>{{ m.name }}</td>
          <td class="num">{{ "%.4f"|format(m.value) }}</td>
          <td><span class="band band-{{ m.band }}">{{ m.band }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  {% if card.uncertainty %}
  <section>
    <h2>Uncertainty-aware fairness</h2>
    <table>
      <thead>
        <tr><th>Metric</th><th>Value</th><th>Status</th></tr>
      </thead>
      <tbody>
        {% for m in card.uncertainty.metrics %}
        <tr>
          <td><span class="dot band-{{ m.band }}"></span>{{ m.name }}</td>
          <td class="num">{{ "%.4f"|format(m.value) }}</td>
          <td><span class="band band-{{ m.band }}">{{ m.band }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if card.explainability %}
  <section>
    <h2>Explainability</h2>
    <p style="margin:0 0 6px 0;"><strong>Top features:</strong></p>
    <div>
      {% for f in card.explainability.top_features %}
      <span class="tag">{{ f }}</span>
      {% else %}
      <span class="muted">none reported</span>
      {% endfor %}
    </div>
    {% if card.explainability.importance_flips %}
    <p style="margin:8px 0 4px 0;"><strong>Importance flips across sensitive groups:</strong></p>
    <div>
      {% for flip in card.explainability.importance_flips %}
      <span class="tag" style="background:#d23b3b;">{{ flip }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <footer>
    Generated by TinyAudit from manifest: {{ card.manifest_path }}
  </footer>

</div>
</body>
</html>
